# 数据库连接地址；本地开发默认使用项目 data 目录中的 SQLite 文件。
DATABASE_URL=sqlite:///./data/cdkloader.db

# Docker 对外暴露的宿主机端口。
CDK_LOADER_PORT=1456
# Docker Compose 构建或部署时使用的镜像名；使用 YYYYMMDD 固定版本，或改为 :latest 使用最新版。
CDK_LOADER_IMAGE=ghcr.io/hermitchen/cdkloader:latest

# 管理后台登录密码；生产环境必须替换为强密码。
ADMIN_PASSWORD=change-me
# 管理接口 Bearer Token；前端登录后使用，生产环境必须替换为随机长字符串。
ADMIN_TOKEN=change-me-admin-token

# 账号 OAuth 凭据的 AES 加密密钥；变更后将无法解密已入库的账号凭据。
CREDENTIAL_SECRET=replace-with-a-long-random-secret
# CDK、兑换令牌等摘要计算密钥；生产环境使用与 CREDENTIAL_SECRET 不同的随机长字符串。
CDK_PEPPER=replace-with-a-different-long-random-secret

# 验活方式：remote 先校验 OpenAI OAuth 身份，再校验实际 ChatGPT 接口；structural 仅检查必要 Token，适用于本地测试。
VALIDATION_MODE=remote
# 单次远端验活请求的超时时间，单位为秒。
VALIDATION_TIMEOUT_SECONDS=5
# 单个账号远端验活失败后的最大尝试次数，最小为 1；临时风控/限流默认最多重试 3 次。
VALIDATION_ATTEMPTS=3
# 验活统一出口代理，留空时直连；建议与账号实际业务出口保持一致。
VALIDATION_PROXY=
# 临时错误重试的初始等待时间，后续按指数退避增长，单位为秒。
VALIDATION_RETRY_BASE_SECONDS=1
# 本地指数退避的最大时间，单位为秒；上游返回 Retry-After 时优先使用上游值。
VALIDATION_RETRY_MAX_SECONDS=30
# 重试等待随机抖动范围，单位为秒，用于避免多个任务同时重试。
VALIDATION_RETRY_JITTER_SECONDS=0.25
# 可同时执行的账号验活任务数量，最小为 1。
VALIDATION_CONCURRENCY=6

# 已兑换 CDK 可补发及下载首次关联账号的时间窗口，单位为秒；设为 0 可关闭公开补发。
REDELIVERY_WINDOW_SECONDS=1800

# 用户访问公开提取页时使用的外部服务地址，不要以斜杠结尾。
PUBLIC_BASE_URL=http://localhost:1456

# 单个账号导入文件最大大小；支持 B/K/M/G/T（按 1024 进制）和 KiB/MiB/GiB/TiB，例如 100M、1.5G。
MAX_UPLOAD_BYTES=100M

# 操作任务和日志保留天数；到期后由服务定期清理。
OPERATION_LOG_RETENTION_DAYS=30
# 导出 ZIP 文件的物理保留时间，单位为秒；补发文件的实际下载截止时间仍由上面的窗口控制。
EXPORT_RETENTION_SECONDS=86400
# 导出任务文件目录；Docker 中应位于 /app/data 持久化卷内。
EXPORT_DIR=./data/exports

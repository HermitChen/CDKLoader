# 数据库连接地址；本地开发默认使用项目 data 目录中的 SQLite 文件。
DATABASE_URL=sqlite:///./data/cdkloader.db

# Docker 对外暴露的宿主机端口。
CDK_LOADER_PORT=1456
# Docker Compose 构建或部署时使用的镜像名；使用 YYYYMMDD 固定版本，或改为 :latest 使用最新版。
CDK_LOADER_IMAGE=ghcr.io/hermitchen/cdkloader:latest

# 管理后台登录密码；生产环境必须替换为强密码。
ADMIN_PASSWORD=change-me
# 管理接口 Bearer Token；前端登录后使用，生产环境必须替换为随机长字符串。
ADMIN_TOKEN=change-me-admin-token

# 账号 OAuth 凭据的 AES 加密密钥；变更后将无法解密已入库的账号凭据。
CREDENTIAL_SECRET=replace-with-a-long-random-secret
# CDK、兑换令牌等摘要计算密钥；生产环境使用与 CREDENTIAL_SECRET 不同的随机长字符串。
CDK_PEPPER=replace-with-a-different-long-random-secret

# 验活、交付、导入限制和自动清理等运行参数首次启动时写入 SQLite，
# 登录管理后台后在“系统参数”页面修改，不再通过环境变量配置。
